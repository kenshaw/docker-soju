[Unit]
Description=Build and push the soju container image
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# install.sh replaces @SRC@ with the directory of this repository, so the unit works wherever the repository is cloned.
WorkingDirectory=@SRC@
ExecStart=@SRC@/build.sh
TimeoutStartSec=30min
